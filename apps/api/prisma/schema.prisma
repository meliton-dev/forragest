generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  CAJERO
  ALMACENISTA
  CHOFER
  GERENTE_COMPRAS
  SUPERVISOR_RUTAS
}

// Línea como tabla (no enum) para agregar líneas sin rediseño.
model ProductLine {
  id       Int       @id @default(autoincrement())
  code     String    @unique
  name     String
  products Product[]
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String
  fullName     String
  role         Role
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  audits       AuditLog[]
  routes       Route[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}

// ---------- Fase 2: Inventario ----------

enum MovementType {
  ENTRADA_COMPRA
  ENTRADA_AJUSTE
  SALIDA_AJUSTE
  SALIDA_VENTA
  SALIDA_MERMA
  CONTEO
  SALIDA_RUTA
  ENTRADA_RUTA
  ENTRADA_DEVOLUCION
}

model Product {
  id            Int         @id @default(autoincrement())
  code          String      @unique
  name          String
  description   String?
  lineId        Int
  line          ProductLine @relation(fields: [lineId], references: [id])
  unit          String // unidad base: kg, pza, ...
  purchasePrice Decimal     @db.Decimal(12, 2)
  salePrice     Decimal     @db.Decimal(12, 2)
  minStock      Decimal     @default(0) @db.Decimal(14, 3)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  presentations Presentation[]
  lots          StockLot[]
  movements     InventoryMovement[]
  countItems    InventoryCountItem[]
  stopItems     StopItem[]
  saleItems     SaleItem[]

  @@index([lineId])
}

// INV-002: sacos de 20 kg, 40 kg, granel...
model Presentation {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  factor    Decimal  @db.Decimal(12, 3) // unidades base por presentación
  salePrice Decimal? @db.Decimal(12, 2)

  @@unique([productId, name])
}

// Lotes para valuación PEPS: las salidas consumen primero el lote más antiguo.
model StockLot {
  id         Int                 @id @default(autoincrement())
  productId  Int
  product    Product             @relation(fields: [productId], references: [id])
  quantity   Decimal             @db.Decimal(14, 3) // existencia restante
  unitCost   Decimal             @db.Decimal(12, 2)
  receivedAt DateTime            @default(now())
  expiresAt  DateTime?
  movements  InventoryMovement[]

  @@index([productId, receivedAt])
}

model InventoryMovement {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  lotId     Int?
  lot       StockLot?    @relation(fields: [lotId], references: [id])
  type      MovementType
  quantity  Decimal      @db.Decimal(14, 3) // con signo: + entrada, - salida
  reason    String?
  refType   String? // p. ej. "OrdenCompra", "Venta"
  refId     Int?
  userId    Int?
  createdAt DateTime     @default(now())

  @@index([productId, createdAt])
}

// INV-006: conteo cíclico
model InventoryCount {
  id        Int                  @id @default(autoincrement())
  lineId    Int?
  status    String               @default("ABIERTO") // ABIERTO | CERRADO
  createdBy Int
  createdAt DateTime             @default(now())
  closedAt  DateTime?
  items     InventoryCountItem[]
}

model InventoryCountItem {
  id         Int            @id @default(autoincrement())
  countId    Int
  count      InventoryCount @relation(fields: [countId], references: [id])
  productId  Int
  product    Product        @relation(fields: [productId], references: [id])
  systemQty  Decimal        @db.Decimal(14, 3)
  countedQty Decimal?       @db.Decimal(14, 3)

  @@unique([countId, productId])
}

// ---------- Rutas y repartidores (app móvil) ----------

enum RouteStatus {
  PROGRAMADA
  EN_CURSO
  FINALIZADA
}

enum StopStatus {
  PENDIENTE
  ENTREGADA
  NO_ENTREGADA
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

enum IncidentType {
  CLIENTE_AUSENTE
  PRODUCTO_DANADO
  RETRASO
  OTRO
}

model Customer {
  id          Int         @id @default(autoincrement())
  name        String
  rfc         String?
  address     String
  phone       String?
  contact     String?
  creditLimit Decimal     @default(0) @db.Decimal(12, 2)
  creditDays  Int         @default(0)
  lat         Float?
  lng         Float?
  stops       RouteStop[]
  payments    Payment[]
  sales       Sale[]
}

model Vehicle {
  id     Int     @id @default(autoincrement())
  plate  String  @unique
  name   String
  routes Route[]
}

model Route {
  id               Int            @id @default(autoincrement())
  name             String
  date             DateTime       @db.Date
  driverId         Int
  driver           User           @relation(fields: [driverId], references: [id])
  vehicleId        Int
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  status           RouteStatus    @default(PROGRAMADA)
  departedAt       DateTime?
  returnedAt       DateTime?
  plannedDeparture String?
  stops            RouteStop[]
  pings            LocationPing[]
  payments         Payment[]
  incidents        Incident[]

  @@index([driverId, date])
}

model RouteStop {
  id           Int        @id @default(autoincrement())
  routeId      Int
  route        Route      @relation(fields: [routeId], references: [id])
  customerId   Int
  customer     Customer   @relation(fields: [customerId], references: [id])
  sequence     Int
  status       StopStatus @default(PENDIENTE)
  eta          String?
  instructions String?
  paymentTerms String     @default("Contado")
  arrivedAt    DateTime?
  deliveredAt  DateTime?
  failReason   String?
  failNotes    String?
  signature    String?    @db.Text
  photo        String?    @db.Text
  items        StopItem[]
  payments     Payment[]
  incidents    Incident[]

  @@index([routeId, sequence])
}

model StopItem {
  id           Int       @id @default(autoincrement())
  stopId       Int
  stop         RouteStop @relation(fields: [stopId], references: [id])
  productId    Int
  product      Product   @relation(fields: [productId], references: [id])
  presentation String
  factor       Decimal   @default(1) @db.Decimal(12, 3)
  quantity     Decimal   @db.Decimal(14, 3)
  unitPrice    Decimal   @db.Decimal(12, 2)
  deliveredQty Decimal   @default(0) @db.Decimal(14, 3)
}

// Cobros en ruta; clientOpId hace idempotente el reenvío desde la cola sin conexión.
model Payment {
  id         Int           @id @default(autoincrement())
  routeId    Int
  route      Route         @relation(fields: [routeId], references: [id])
  stopId     Int?
  stop       RouteStop?    @relation(fields: [stopId], references: [id])
  customerId Int?
  customer   Customer?     @relation(fields: [customerId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  receivedAt DateTime
  clientOpId String        @unique
  userId     Int
}

model Incident {
  id          Int          @id @default(autoincrement())
  routeId     Int
  route       Route        @relation(fields: [routeId], references: [id])
  stopId      Int?
  stop        RouteStop?   @relation(fields: [stopId], references: [id])
  type        IncidentType
  description String
  photo       String?      @db.Text
  createdAt   DateTime
  clientOpId  String       @unique
  userId      Int
}

// ---------- Fase 3: Punto de venta ----------

enum SaleStatus {
  PAGADA
  POR_COBRAR
  CANCELADA
}

enum SalePayment {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CREDITO
}

enum RefundMethod {
  EFECTIVO
  TARJETA
  SALDO_A_FAVOR
}

enum ShiftStatus {
  ABIERTO
  CERRADO
}

model CashShift {
  id            Int          @id @default(autoincrement())
  register      String       @default("Caja 1")
  cashierId     Int
  openedAt      DateTime     @default(now())
  closedAt      DateTime?
  openingFloat  Decimal      @db.Decimal(12, 2)
  status        ShiftStatus  @default(ABIERTO)
  expectedCash  Decimal?     @db.Decimal(12, 2)
  countedCash   Decimal?     @db.Decimal(12, 2)
  difference    Decimal?     @db.Decimal(12, 2)
  denominations Json?
  notes         String?
  sales         Sale[]
  creditNotes   CreditNote[]
}

model Sale {
  id                     Int          @id @default(autoincrement())
  folio                  Int          @unique @default(autoincrement())
  shiftId                Int
  shift                  CashShift    @relation(fields: [shiftId], references: [id])
  cashierId              Int
  customerId             Int?
  customer               Customer?    @relation(fields: [customerId], references: [id])
  status                 SaleStatus
  paymentMethod          SalePayment
  subtotal               Decimal      @db.Decimal(12, 2)
  discountAmount         Decimal      @default(0) @db.Decimal(12, 2)
  total                  Decimal      @db.Decimal(12, 2)
  received               Decimal?     @db.Decimal(12, 2)
  change                 Decimal?     @db.Decimal(12, 2)
  balance                Decimal      @default(0) @db.Decimal(12, 2)
  dueDate                DateTime?    @db.Date
  discountAuthorizedById Int?
  createdAt              DateTime     @default(now())
  cancelledAt            DateTime?
  cancelReason           String?
  cancelAuthorizedById   Int?
  clientOpId             String?      @unique
  items                  SaleItem[]
  creditNotes            CreditNote[]

  @@index([createdAt])
  @@index([customerId, status])
}

model SaleItem {
  id           Int              @id @default(autoincrement())
  saleId       Int
  sale         Sale             @relation(fields: [saleId], references: [id])
  productId    Int
  product      Product          @relation(fields: [productId], references: [id])
  presentation String
  factor       Decimal          @db.Decimal(12, 3)
  quantity     Decimal          @db.Decimal(14, 3)
  unitPrice    Decimal          @db.Decimal(12, 2)
  total        Decimal          @db.Decimal(12, 2)
  costTotal    Decimal          @default(0) @db.Decimal(12, 2)
  returnedQty  Decimal          @default(0) @db.Decimal(14, 3)
  noteItems    CreditNoteItem[]
}

model CreditNote {
  id           Int              @id @default(autoincrement())
  folio        Int              @unique @default(autoincrement())
  saleId       Int
  sale         Sale             @relation(fields: [saleId], references: [id])
  shiftId      Int
  shift        CashShift        @relation(fields: [shiftId], references: [id])
  total        Decimal          @db.Decimal(12, 2)
  refundMethod RefundMethod
  reason       String
  comments     String?
  userId       Int
  createdAt    DateTime         @default(now())
  items        CreditNoteItem[]
}

model CreditNoteItem {
  id           Int        @id @default(autoincrement())
  creditNoteId Int
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id])
  saleItemId   Int
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
  quantity     Decimal    @db.Decimal(14, 3)
  amount       Decimal    @db.Decimal(12, 2)
}

// Ubicación del camión reportada por la app del repartidor (mientras la ruta está en curso).
model LocationPing {
  id         Int      @id @default(autoincrement())
  routeId    Int
  route      Route    @relation(fields: [routeId], references: [id])
  lat        Float
  lng        Float
  accuracy   Float?
  recordedAt DateTime

  @@unique([routeId, recordedAt])
}
