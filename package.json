{
  "name": "forrajera",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "api:dev": "npm run start:dev -w apps/api",
    "api:test": "npm test -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "driver:dev": "npm run dev -w apps/driver",
    "driver:build": "npm run build -w apps/driver",
    "driver:preview": "npm run preview -w apps/driver",
    "driver:test": "npm test -w apps/driver",
    "api:smoke": "node apps/api/test/driver-flow.smoke.mjs",
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:preview": "npm run preview -w apps/web",
    "web:test": "npm test -w apps/web",
    "pos:smoke": "node apps/api/test/pos-flow.smoke.mjs",
    "routes:smoke": "node apps/api/test/routes-flow.smoke.mjs",
    "reporte:remoto": "node scripts/reporte-remoto.mjs",
    "api:test:int": "npm run test:int -w apps/api"
  },
  "devDependencies": {
    "playwright-core": "^1.48.2"
  }
}
