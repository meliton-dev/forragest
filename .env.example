# ===== API (apps/api/.env) =====
DATABASE_URL=postgresql://forrajera:forrajera@localhost:5432/forrajera
# genera uno largo y aleatorio:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=3000
# detalle de los registros: debug, info (por defecto), warn, error
LOG_LEVEL=info
# orígenes permitidos (separados por coma, con https:// y sin ruta). Vacío = cualquiera (solo desarrollo); en producción es obligatorio
CORS_ORIGINS=
# contraseña inicial de los usuarios de demostración al ejecutar el seed
SEED_PASSWORD=

# ===== Apps (se definen al compilar: apps/driver y apps/web) =====
# URL pública de la API en el servidor. Sin ella las apps usan /api (proxy de desarrollo), que es lo correcto en local:
# NO la pongas en tu PC o la copia local hablaría con producción. Solo se define en Render al compilar la app del chofer.
# VITE_API_URL=https://forragest-api.onrender.com

# servicio de rutas por calles (OSRM). Si no se define, se usa el servidor público y gratuito, que recibe las coordenadas de las paradas.
# Vacío = sin servicio (líneas rectas); `npm run local` lo deja vacío salvo con --calles. Para uso intensivo conviene un servidor propio o de pago.
# ROUTING_URL=https://router.project-osrm.org

# zona horaria del negocio: define "hoy", las horas estimadas y el día de las ventas. El servidor corre en UTC.
# Por defecto America/Mexico_City.
# APP_TIMEZONE=America/Mexico_City
